{
  "name": "ts-shell",
  "version": "1.0.0",
  "description": "TS-OS CLI",
  "main": "dist/GUI/main.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "tsc --build --force && node -e \"require('fs').copyFileSync('GUI/index.html', 'dist/GUI/index.html'); require('fs').copyFileSync('GUI/style.css', 'dist/GUI/style.css');\" && electron .",
    "make": "tsc --build --force && node -e \"require('fs').copyFileSync('GUI/index.html', 'dist/GUI/index.html'); require('fs').copyFileSync('GUI/style.css', 'dist/GUI/style.css');\" && electron-forge make",
    "package": "electron-forge package"
  },
